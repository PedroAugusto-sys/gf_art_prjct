# ===================================================
# Configuração do Museu GF Art Project
# ===================================================

# ---------- MULTIPLAYER (Playroom Kit) ----------
# Obrigatório em produção. O Vite grava o valor no build: mudar no Netlify
# sem um deploy novo não altera o site. Obtenha em https://app.joinplayroom.com
VITE_PLAYROOM_GAME_ID=

# ---------- UPLOADS TEMPORÁRIOS (opcional) ----------
# Sem esta variável o site publica a imagem direto na sala do Playroom.
# Não use localhost na Netlify: o build de produção ignora essa URL.
# Desenvolvimento, só se o servidor em server/ estiver rodando:
# VITE_ART_SERVER_URL=http://localhost:3001
# VITE_UPLOAD_SERVER_URL também é aceita.
VITE_ART_SERVER_URL=

# ---------- SERVIDOR BACKEND (server/) ----------
# Porta do servidor Node.js
PORT=3001

# Tempo de tolerância para reconexão (ms)
# Default: 60000 (60 segundos)
# Enquanto um jogador permanecer na sala dentro deste prazo após desconexão,
# a sessão e uploads são preservados
RECONNECT_GRACE_MS=60000
