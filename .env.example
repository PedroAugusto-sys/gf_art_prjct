# ===================================================
# Configuração do Museu GF Art Project
# ===================================================

# ---------- MULTIPLAYER (Playroom Kit) ----------
# Opcional: Game ID para produção (sem limite de DAU)
# Sem configurar: funciona com limite de desenvolvimento
# Obtenha em: https://app.joinplayroom.com
VITE_PLAYROOM_GAME_ID=

# ---------- UPLOADS TEMPORÁRIOS ----------
# URL do servidor backend para uploads temporários por sessão
# Desenvolvimento: http://localhost:3001
# Produção: https://seu-servidor.com
VITE_ART_SERVER_URL=http://localhost:3001

# ---------- SERVIDOR BACKEND (server/) ----------
# Porta do servidor Node.js
PORT=3001

# Tempo de tolerância para reconexão (ms)
# Default: 60000 (60 segundos)
# Enquanto um jogador permanecer na sala dentro deste prazo após desconexão,
# a sessão e uploads são preservados
RECONNECT_GRACE_MS=60000
